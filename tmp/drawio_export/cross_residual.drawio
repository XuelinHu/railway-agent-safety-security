<mxfile host="app.diagrams.net" modified="2026-09-09T00:00:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="cross-residual-training" name="Cross-Residual Training Architecture">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3000" pageHeight="1700" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;Validation-Gated Cross-Residual Adaptation for Cross-Domain NER&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=34;fontColor=#111827;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="310" y="24" width="2380" height="55" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Target-domain training learns a score correction; validation controls how strongly it crosses into the frozen identity path" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontColor=#4B5563;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="450" y="76" width="2100" height="38" as="geometry"/></mxCell>
        <mxCell id="stage1" value="1  SHARED INPUT" style="rounded=1;whiteSpace=wrap;html=1;align=center;fontFamily=Arial;fontSize=18;fontStyle=1;fillColor=#E5E7EB;strokeColor=#6B7280;strokeWidth=1.5;fontColor=#111827;arcSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="135" width="430" height="52" as="geometry"/></mxCell>
        <mxCell id="stage2" value="2  TWIN LABEL-CONDITIONED SPAN RECOGNIZERS" style="rounded=1;whiteSpace=wrap;html=1;align=center;fontFamily=Arial;fontSize=18;fontStyle=1;fillColor=#E5E7EB;strokeColor=#6B7280;strokeWidth=1.5;fontColor=#111827;arcSize=12;" vertex="1" parent="1"><mxGeometry x="590" y="135" width="1330" height="52" as="geometry"/></mxCell>
        <mxCell id="stage3" value="3  CROSS-RESIDUAL FUSION" style="rounded=1;whiteSpace=wrap;html=1;align=center;fontFamily=Arial;fontSize=18;fontStyle=1;fillColor=#FCE7F3;strokeColor=#BE185D;strokeWidth=2;fontColor=#831843;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1980" y="135" width="610" height="52" as="geometry"/></mxCell>
        <mxCell id="stage4" value="4  DECODE" style="rounded=1;whiteSpace=wrap;html=1;align=center;fontFamily=Arial;fontSize=18;fontStyle=1;fillColor=#E5E7EB;strokeColor=#6B7280;strokeWidth=1.5;fontColor=#111827;arcSize=12;" vertex="1" parent="1"><mxGeometry x="2650" y="135" width="270" height="52" as="geometry"/></mxCell>
        <mxCell id="input" value="&lt;b&gt;Sentence x&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4B5563&quot;&gt;token sequence&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Domain label set Y&lt;sub&gt;d&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4B5563&quot;&gt;textual entity descriptions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=22;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=2.5;fontColor=#111827;arcSize=10;" vertex="1" parent="1"><mxGeometry x="95" y="390" width="380" height="250" as="geometry"/></mxCell>
        <mxCell id="same-interface" value="Matched tokenization, label descriptions,&lt;br&gt;candidate construction and decoding" style="rounded=1;whiteSpace=wrap;html=1;align=center;fontFamily=Arial;fontSize=16;fillColor=#FFF7ED;strokeColor=#C2410C;dashed=1;strokeWidth=1.5;fontColor=#7C2D12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="95" y="675" width="380" height="92" as="geometry"/></mxCell>
        <mxCell id="general-container" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2.5;arcSize=10;" vertex="1" parent="1"><mxGeometry x="590" y="220" width="1330" height="430" as="geometry"/></mxCell>
        <mxCell id="general-label" value="&lt;b&gt;GENERAL IDENTITY BRANCH&lt;/b&gt;  -  pretrained GLiNER-small-v2.1, parameters θ&lt;sub&gt;0&lt;/sub&gt; frozen" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=21;fontColor=#1E3A8A;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="625" y="237" width="1180" height="45" as="geometry"/></mxCell>
        <mxCell id="g-embed" value="&lt;b&gt;Token + label&lt;br&gt;embeddings&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;sentence and label queries&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;fontFamily=Arial;fontSize=18;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=1.8;fontColor=#111827;arcSize=8;" vertex="1" parent="1"><mxGeometry x="635" y="315" width="220" height="150" as="geometry"/></mxCell>
        <mxCell id="g-attn" value="&lt;b&gt;Bidirectional Transformer encoder x N&lt;/b&gt;&lt;br&gt;&lt;br&gt;Q   K   V  -  Multi-Head Self-Attention&lt;br&gt;Add &amp;amp; Norm  -  Feed-Forward Network&lt;br&gt;Add &amp;amp; Norm" style="rounded=1;whiteSpace=wrap;html=1;align=center;fontFamily=Arial;fontSize=18;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=2;fontColor=#0F172A;arcSize=8;" vertex="1" parent="1"><mxGeometry x="900" y="292" width="480" height="198" as="geometry"/></mxCell>
        <mxCell id="g-span" value="&lt;b&gt;Span-label interaction&lt;/b&gt;&lt;br&gt;h&lt;sub&gt;b:e&lt;/sub&gt; ⊗ q&lt;sub&gt;y&lt;/sub&gt;&lt;br&gt;compatibility head g&lt;sub&gt;θ0&lt;/sub&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;fontFamily=Arial;fontSize=18;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=1.8;fontColor=#111827;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1425" y="315" width="225" height="150" as="geometry"/></mxCell>
        <mxCell id="g-matrix" value="&lt;b&gt;General score matrix S&lt;sub&gt;0&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;[ s&lt;sub&gt;0&lt;/sub&gt;(b,e,y) ]&lt;br&gt;s&lt;sub&gt;0&lt;/sub&gt;(c)=σ(z&lt;sub&gt;θ0&lt;/sub&gt;(c))" style="rounded=1;whiteSpace=wrap;html=1;align=center;fontFamily=Times New Roman;fontSize=19;fillColor=#BFDBFE;strokeColor=#1D4ED8;strokeWidth=2.5;fontColor=#172554;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1690" y="315" width="195" height="150" as="geometry"/></mxCell>
        <mxCell id="g-note" value="Stable reference evidence - never updated on target train split" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontStyle=2;fontColor=#1D4ED8;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="820" y="525" width="850" height="45" as="geometry"/></mxCell>
        <mxCell id="adapt-container" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2.5;arcSize=10;" vertex="1" parent="1"><mxGeometry x="590" y="700" width="1330" height="430" as="geometry"/></mxCell>
        <mxCell id="adapt-label" value="&lt;b&gt;TARGET ADAPTATION BRANCH&lt;/b&gt;  -  initialized from θ&lt;sub&gt;0&lt;/sub&gt;, optimized to θ&lt;sub&gt;1&lt;/sub&gt; on D&lt;sub&gt;d&lt;/sub&gt;&lt;sup&gt;train&lt;/sup&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=21;fontColor=#9A3412;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="625" y="717" width="1180" height="45" as="geometry"/></mxCell>
        <mxCell id="a-embed" value="&lt;b&gt;Token + label&lt;br&gt;embeddings&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;same input interface&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;fontFamily=Arial;fontSize=18;fillColor=#FFEDD5;strokeColor=#F97316;strokeWidth=1.8;fontColor=#111827;arcSize=8;" vertex="1" parent="1"><mxGeometry x="635" y="795" width="220" height="150" as="geometry"/></mxCell>
        <mxCell id="a-attn" value="&lt;b&gt;Bidirectional Transformer encoder x N&lt;/b&gt;&lt;br&gt;&lt;br&gt;Q   K   V  -  Multi-Head Self-Attention&lt;br&gt;Add &amp;amp; Norm  -  Feed-Forward Network&lt;br&gt;Add &amp;amp; Norm" style="rounded=1;whiteSpace=wrap;html=1;align=center;fontFamily=Arial;fontSize=18;fillColor=#FFEDD5;strokeColor=#F97316;strokeWidth=2;fontColor=#0F172A;arcSize=8;" vertex="1" parent="1"><mxGeometry x="900" y="772" width="480" height="198" as="geometry"/></mxCell>
        <mxCell id="a-span" value="&lt;b&gt;Span-label interaction&lt;/b&gt;&lt;br&gt;h&lt;sub&gt;b:e&lt;/sub&gt; ⊗ q&lt;sub&gt;y&lt;/sub&gt;&lt;br&gt;compatibility head g&lt;sub&gt;θ1&lt;/sub&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;fontFamily=Arial;fontSize=18;fillColor=#FFEDD5;strokeColor=#F97316;strokeWidth=1.8;fontColor=#111827;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1425" y="795" width="225" height="150" as="geometry"/></mxCell>
        <mxCell id="a-matrix" value="&lt;b&gt;Adapted score matrix S&lt;sub&gt;1&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;[ s&lt;sub&gt;1&lt;/sub&gt;(b,e,y) ]&lt;br&gt;s&lt;sub&gt;1&lt;/sub&gt;(c)=σ(z&lt;sub&gt;θ1&lt;/sub&gt;(c))" style="rounded=1;whiteSpace=wrap;html=1;align=center;fontFamily=Times New Roman;fontSize=19;fillColor=#FED7AA;strokeColor=#C2410C;strokeWidth=2.5;fontColor=#7C2D12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1690" y="795" width="195" height="150" as="geometry"/></mxCell>
        <mxCell id="loss" value="&lt;b&gt;Span classification loss&lt;/b&gt;&lt;br&gt;L&lt;sub&gt;d&lt;/sub&gt;(θ&lt;sub&gt;1&lt;/sub&gt;) = BCE over candidates&lt;br&gt;&lt;font color=&quot;#9A3412&quot;&gt;gradient update only on θ&lt;sub&gt;1&lt;/sub&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;fontFamily=Arial;fontSize=17;fillColor=#FFFFFF;strokeColor=#EA580C;dashed=1;strokeWidth=1.8;fontColor=#111827;arcSize=8;" vertex="1" parent="1"><mxGeometry x="985" y="1005" width="410" height="92" as="geometry"/></mxCell>
        <mxCell id="train-data" value="&lt;b&gt;Official target-domain train split&lt;/b&gt;&lt;br&gt;sentence + BIO-derived typed spans&lt;br&gt;&lt;font color=&quot;#7C2D12&quot;&gt;training supervision only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;fontFamily=Arial;fontSize=18;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;fontColor=#111827;arcSize=8;" vertex="1" parent="1"><mxGeometry x="95" y="890" width="380" height="145" as="geometry"/></mxCell>
        <mxCell id="init" value="Copy θ&lt;sub&gt;0&lt;/sub&gt; → θ&lt;sub&gt;1&lt;/sub&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;same model family; different final parameters&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;fontFamily=Arial;fontSize=16;fillColor=#F3F4F6;strokeColor=#6B7280;dashed=1;strokeWidth=1.5;fontColor=#111827;arcSize=8;" vertex="1" parent="1"><mxGeometry x="95" y="1070" width="380" height="92" as="geometry"/></mxCell>
        <mxCell id="fusion-container" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;opacity=70;strokeColor=#BE185D;strokeWidth=3;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1980" y="220" width="610" height="910" as="geometry"/></mxCell>
        <mxCell id="identity" value="&lt;b&gt;Identity path&lt;/b&gt;&lt;br&gt;s&lt;sub&gt;0&lt;/sub&gt;(c)" style="rounded=1;whiteSpace=wrap;html=1;align=center;fontFamily=Times New Roman;fontSize=21;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2.5;fontColor=#172554;arcSize=8;" vertex="1" parent="1"><mxGeometry x="2030" y="300" width="190" height="100" as="geometry"/></mxCell>
        <mxCell id="union" value="Candidate union C&lt;sup&gt;∪&lt;/sup&gt; = C&lt;sub&gt;0&lt;/sub&gt; ∪ C&lt;sub&gt;1&lt;/sub&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;missing score = 0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;fontFamily=Times New Roman;fontSize=18;fillColor=#FFFFFF;strokeColor=#9CA3AF;strokeWidth=1.5;fontColor=#111827;arcSize=8;" vertex="1" parent="1"><mxGeometry x="2030" y="455" width="500" height="78" as="geometry"/></mxCell>
        <mxCell id="subtract" value="&lt;b&gt;SIGNED CROSS-RESIDUAL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:26px&quot;&gt;Δ&lt;sub&gt;d&lt;/sub&gt;(c) = s&lt;sub&gt;1&lt;/sub&gt;(c) - s&lt;sub&gt;0&lt;/sub&gt;(c)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#9F1239&quot;&gt;explicit target-induced correction&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;fontFamily=Times New Roman;fontSize=19;fillColor=#FCE7F3;strokeColor=#BE185D;strokeWidth=4;fontColor=#831843;arcSize=12;" vertex="1" parent="1"><mxGeometry x="2030" y="610" width="500" height="150" as="geometry"/></mxCell>
        <mxCell id="gate" value="&lt;b&gt;Validation gate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:27px&quot;&gt;α&lt;sub&gt;d&lt;/sub&gt;&lt;sup&gt;*&lt;/sup&gt; × Δ&lt;sub&gt;d&lt;/sub&gt;(c)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#6B21A8&quot;&gt;damp / reproduce / amplify&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;fontFamily=Times New Roman;fontSize=19;fillColor=#F3E8FF;strokeColor=#7E22CE;strokeWidth=3;fontColor=#581C87;arcSize=10;" vertex="1" parent="1"><mxGeometry x="2030" y="820" width="500" height="130" as="geometry"/></mxCell>
        <mxCell id="add" value="+" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=38;fontStyle=1;fillColor=#FFFFFF;strokeColor=#BE185D;strokeWidth=4;fontColor=#831843;" vertex="1" parent="1"><mxGeometry x="2040" y="1000" width="110" height="110" as="geometry"/></mxCell>
        <mxCell id="formula" value="&lt;b&gt;Fused score&lt;/b&gt;&lt;br&gt;s&lt;sub&gt;f&lt;/sub&gt;(c) = s&lt;sub&gt;0&lt;/sub&gt;(c) + α&lt;sub&gt;d&lt;/sub&gt;&lt;sup&gt;*&lt;/sup&gt;Δ&lt;sub&gt;d&lt;/sub&gt;(c)" style="rounded=1;whiteSpace=wrap;html=1;align=center;fontFamily=Times New Roman;fontSize=20;fillColor=#FFFFFF;strokeColor=#BE185D;strokeWidth=3;fontColor=#831843;arcSize=8;" vertex="1" parent="1"><mxGeometry x="2210" y="990" width="340" height="130" as="geometry"/></mxCell>
        <mxCell id="val-data" value="&lt;b&gt;Official development split&lt;/b&gt;&lt;br&gt;select α and threshold τ only&lt;br&gt;&lt;font color=&quot;#581C87&quot;&gt;no test-label access&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;fontFamily=Arial;fontSize=18;fillColor=#FAF5FF;strokeColor=#7E22CE;strokeWidth=2;fontColor=#111827;arcSize=8;" vertex="1" parent="1"><mxGeometry x="610" y="1240" width="385" height="130" as="geometry"/></mxCell>
        <mxCell id="selector" value="&lt;b&gt;Validation-only model selection&lt;/b&gt;&lt;br&gt;(α&lt;sub&gt;d&lt;/sub&gt;&lt;sup&gt;*&lt;/sup&gt;, τ&lt;sub&gt;d&lt;/sub&gt;&lt;sup&gt;*&lt;/sup&gt;) = arg max F&lt;sub&gt;1&lt;/sub&gt;&lt;br&gt;α ∈ {0.75, 1.00, 1.25, 1.50}" style="rounded=1;whiteSpace=wrap;html=1;align=center;fontFamily=Times New Roman;fontSize=19;fillColor=#F3E8FF;strokeColor=#7E22CE;strokeWidth=2.5;fontColor=#581C87;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1060" y="1225" width="560" height="160" as="geometry"/></mxCell>
        <mxCell id="regimes" value="&lt;b&gt;Interpretable residual regimes&lt;/b&gt;&lt;br&gt;α=0: frozen general  |  α=1: ordinary adaptation&lt;br&gt;0&lt;α&lt;1: damp correction  |  α&gt;1: amplify correction" style="rounded=1;whiteSpace=wrap;html=1;align=center;fontFamily=Arial;fontSize=17;fillColor=#FFF1F2;strokeColor=#BE185D;dashed=1;strokeWidth=1.8;fontColor=#831843;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1690" y="1235" width="840" height="140" as="geometry"/></mxCell>
        <mxCell id="decode" value="&lt;b&gt;Threshold + overlap resolution&lt;/b&gt;&lt;br&gt;s&lt;sub&gt;f&lt;/sub&gt;(c) ≥ τ&lt;sub&gt;d&lt;/sub&gt;&lt;sup&gt;*&lt;/sup&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;fontFamily=Arial;fontSize=19;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2.5;fontColor=#064E3B;arcSize=8;" vertex="1" parent="1"><mxGeometry x="2660" y="800" width="245" height="130" as="geometry"/></mxCell>
        <mxCell id="output" value="&lt;b&gt;Typed entity spans&lt;/b&gt;&lt;br&gt;P&lt;sub&gt;d&lt;/sub&gt;(x) = {(b,e,y)}&lt;br&gt;&lt;font color=&quot;#047857&quot;&gt;strict boundary + type&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;fontFamily=Times New Roman;fontSize=20;fillColor=#D1FAE5;strokeColor=#047857;strokeWidth=3;fontColor=#064E3B;arcSize=8;" vertex="1" parent="1"><mxGeometry x="2660" y="1010" width="245" height="145" as="geometry"/></mxCell>
        <mxCell id="no-fusion-net" value="No trainable fusion network&lt;br&gt;candidate-wise arithmetic only" style="rounded=1;whiteSpace=wrap;html=1;align=center;fontFamily=Arial;fontSize=16;fontStyle=2;fillColor=#FFFFFF;strokeColor=#9CA3AF;dashed=1;fontColor=#4B5563;arcSize=8;" vertex="1" parent="1"><mxGeometry x="2658" y="1235" width="248" height="90" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;     &lt;font color=&quot;#1D4ED8&quot;&gt;■ frozen identity&lt;/font&gt;     &lt;font color=&quot;#C2410C&quot;&gt;■ trainable adaptation&lt;/font&gt;     &lt;font color=&quot;#BE185D&quot;&gt;■ cross-residual&lt;/font&gt;     &lt;font color=&quot;#7E22CE&quot;&gt;■ validation control&lt;/font&gt;     &lt;font color=&quot;#047857&quot;&gt;■ decoded output&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;fontFamily=Arial;fontSize=17;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#111827;arcSize=8;" vertex="1" parent="1"><mxGeometry x="490" y="1510" width="2020" height="75" as="geometry"/></mxCell>
        <mxCell id="note" value="Transformer internal residuals stabilize each encoder; the paper's innovation is the external cross-branch score residual shown in magenta." style="text;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontStyle=2;fontColor=#4B5563;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="500" y="1435" width="2000" height="45" as="geometry"/></mxCell>
        <mxCell id="e-input-g" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2563EB;strokeWidth=2.5;exitX=1;exitY=0.35;entryX=0;entryY=0.5;" edge="1" parent="1" source="input" target="g-embed"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-input-a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#EA580C;strokeWidth=2.5;exitX=1;exitY=0.72;entryX=0;entryY=0.5;" edge="1" parent="1" source="input" target="a-embed"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-g1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#2563EB;strokeWidth=2;" edge="1" parent="1" source="g-embed" target="g-attn"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-g2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#2563EB;strokeWidth=2;" edge="1" parent="1" source="g-attn" target="g-span"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-g3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#2563EB;strokeWidth=2;" edge="1" parent="1" source="g-span" target="g-matrix"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-a1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#EA580C;strokeWidth=2;" edge="1" parent="1" source="a-embed" target="a-attn"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-a2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#EA580C;strokeWidth=2;" edge="1" parent="1" source="a-attn" target="a-span"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-a3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#EA580C;strokeWidth=2;" edge="1" parent="1" source="a-span" target="a-matrix"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-train" value="supervision" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#EA580C;strokeWidth=2;dashed=1;fontFamily=Arial;fontSize=15;fontColor=#9A3412;" edge="1" parent="1" source="train-data" target="loss"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-loss" value="backpropagation" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#EA580C;strokeWidth=2.5;dashed=1;fontFamily=Arial;fontSize=15;fontColor=#9A3412;entryX=0.5;entryY=1;" edge="1" parent="1" source="loss" target="a-attn"><mxGeometry relative="1" as="geometry"/></mxCell>
