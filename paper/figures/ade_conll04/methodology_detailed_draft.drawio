        <mxCell id="kg" value="&lt;b&gt;DATASET-SPECIFIC TRAINING KG (ADE)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#526777&quot;&gt;Nodes and directed edges are derived only from training annotations.&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=22;fontColor=#17324d;fillColor=#fcecef;strokeColor=#b84c6a;strokeWidth=2;align=center;verticalAlign=middle;rounded=1;arcSize=12;fontStyle=1;fontSize=12;" vertex="1" parent="1">
