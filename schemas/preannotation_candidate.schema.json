{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Teacher-model safety risk pre-annotation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_id", "language", "entities", "relations", "review"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["0.1.0"]},
    "document_id": {"type": "string"},
    "language": {"type": "string", "enum": ["en", "zh", "mixed", "unknown"]},
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "type", "evidence", "confidence", "review_status", "created_by"],
        "properties": {
          "id": {"type": "string", "pattern": "^E[0-9]+$"},
          "text": {"type": "string"},
          "type": {"type": "string", "enum": ["EVENT", "HAZARD", "ASSET", "ACTOR", "OPERATION", "FAILURE", "HUMAN_FACTOR", "ORGANIZATIONAL_FACTOR", "ENVIRONMENT", "BARRIER", "CONSEQUENCE", "MITIGATION", "LOCATION", "TIME", "REGULATION"]},
          "evidence": {"$ref": "#/$defs/evidence"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "review_status": {"type": "string", "enum": ["pending"]},
          "created_by": {"type": "string"}
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source_id", "type", "target_id", "claim_status", "evidence", "confidence", "review_status", "created_by"],
        "properties": {
          "id": {"type": "string", "pattern": "^R[0-9]+$"},
          "source_id": {"type": "string", "pattern": "^E[0-9]+$"},
          "type": {"type": "string", "enum": ["causes", "contributes_to", "precedes", "results_in", "occurs_at", "involves", "affects", "performed_by", "fails_during", "protected_by", "violates", "mitigated_by", "recommended_for", "part_of", "same_as"]},
          "target_id": {"type": "string", "pattern": "^E[0-9]+$"},
          "claim_status": {"type": "string", "enum": ["explicit", "inferred", "normative", "uncertain"]},
          "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "review_status": {"type": "string", "enum": ["pending"]},
          "created_by": {"type": "string"}
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewers", "notes"],
      "properties": {
        "status": {"type": "string", "enum": ["unreviewed"]},
        "reviewers": {"type": "array", "maxItems": 0},
        "notes": {"type": "string"}
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segment_id", "text"],
      "properties": {
        "segment_id": {"type": "string"},
        "text": {"type": "string", "minLength": 1}
      }
    }
  }
}
