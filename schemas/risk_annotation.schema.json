{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/risk_annotation.schema.json",
  "title": "Evidence-grounded safety risk annotation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_id", "language", "entities", "relations", "review"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "document_id": {"type": "string", "minLength": 1},
    "language": {"enum": ["en", "zh", "mixed", "unknown"]},
    "entities": {
      "type": "array",
      "items": {"$ref": "#/$defs/entity"}
    },
    "relations": {
      "type": "array",
      "items": {"$ref": "#/$defs/relation"}
    },
    "review": {"$ref": "#/$defs/review"}
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "segment_id", "start", "end"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "segment_id": {"type": "string", "minLength": 1},
        "page": {"type": ["integer", "null"], "minimum": 1},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1}
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "type", "evidence", "confidence", "review_status"],
      "properties": {
        "id": {"type": "string", "pattern": "^E[0-9]+$"},
        "text": {"type": "string", "minLength": 1},
        "normalized_name": {"type": ["string", "null"]},
        "type": {
          "enum": ["EVENT", "HAZARD", "ASSET", "ACTOR", "OPERATION", "FAILURE", "HUMAN_FACTOR", "ORGANIZATIONAL_FACTOR", "ENVIRONMENT", "BARRIER", "CONSEQUENCE", "MITIGATION", "LOCATION", "TIME", "REGULATION"]
        },
        "evidence": {"$ref": "#/$defs/evidence"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "review_status": {"enum": ["pending", "accepted", "rejected", "modified"]},
        "created_by": {"type": ["string", "null"]}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_id", "type", "target_id", "claim_status", "evidence", "confidence", "review_status"],
      "properties": {
        "id": {"type": "string", "pattern": "^R[0-9]+$"},
        "source_id": {"type": "string", "pattern": "^E[0-9]+$"},
        "type": {
          "enum": ["causes", "contributes_to", "precedes", "results_in", "occurs_at", "involves", "affects", "performed_by", "fails_during", "protected_by", "violates", "mitigated_by", "recommended_for", "part_of", "same_as"]
        },
        "target_id": {"type": "string", "pattern": "^E[0-9]+$"},
        "claim_status": {"enum": ["explicit", "inferred", "normative", "uncertain"]},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "review_status": {"enum": ["pending", "accepted", "rejected", "modified"]},
        "created_by": {"type": ["string", "null"]}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["unreviewed", "single_reviewed", "double_reviewed", "adjudicated"]},
        "reviewers": {"type": "array", "items": {"type": "string"}},
        "notes": {"type": "string"}
      }
    }
  }
}
